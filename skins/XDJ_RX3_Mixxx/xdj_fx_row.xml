<!-- One effect row of an XDJ-R1 FX pane: name (pink gel while the effect is
     on), level bar (the effect's meta knob = LEVEL/DEPTH), cyan outline while
     it is the effect LEVEL/DEPTH and BEAT are editing. -->
<Template>
  <WidgetGroup>
    <ObjectName>XdjFxRow</ObjectName><Layout>horizontal</Layout><Size>0me,26f</Size>
    <Connection><ConfigKey>[Skin],xdj_fx<Variable name="deck"/>_edit</ConfigKey><Transform><IsEqual><Variable name="index"/></IsEqual></Transform><BindProperty>highlight</BindProperty></Connection>
    <Children>
      <Label>
        <ObjectName>XdjFxName</ObjectName><Text><Variable name="name"/></Text><Size>78f,22f</Size>
        <Connection><ConfigKey>[EffectRack1_EffectUnit<Variable name="unit"/>_Effect<Variable name="slot"/>],enabled</ConfigKey><BindProperty>highlight</BindProperty></Connection>
      </Label>
      <VuMeter>
        <ObjectName>XdjFxLevel</ObjectName><Size>0me,8f</Size>
        <PathVu>skin:/images/progress_fill.svg</PathVu>
        <PathBack>skin:/images/progress_back.svg</PathBack>
        <Horizontal>true</Horizontal>
        <PeakHoldSize>0</PeakHoldSize><PeakHoldTime>0</PeakHoldTime><PeakFallTime>0</PeakFallTime><PeakFallStep>1</PeakFallStep>
        <Connection><ConfigKey>[EffectRack1_EffectUnit<Variable name="unit"/>_Effect<Variable name="slot"/>],meta</ConfigKey></Connection>
      </VuMeter>
    </Children>
  </WidgetGroup>
</Template>
