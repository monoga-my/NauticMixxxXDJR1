<!-- One effect row of an XDJ-R1 FX pane: left-aligned FX button, per-FX BEAT
     column, and per-FX Level/Depth (0-200%) column. -->
<Template>
  <WidgetGroup>
    <ObjectName>XdjFxRow</ObjectName><Layout>horizontal</Layout><Size>0me,26f</Size>
    <Connection><ConfigKey>[Skin],xdj_fx<Variable name="deck"/>_edit</ConfigKey><Transform><IsEqual><Variable name="index"/></IsEqual></Transform><BindProperty>highlight</BindProperty></Connection>
    <Children>
      <Label>
        <ObjectName>XdjFxName</ObjectName><Text><Variable name="name"/></Text><Size>82f,22f</Size>
        <Connection><ConfigKey>[EffectRack1_EffectUnit<Variable name="unit"/>_Effect<Variable name="slot"/>],enabled</ConfigKey><BindProperty>highlight</BindProperty></Connection>
      </Label>
      <WidgetGroup><Size>0me,1f</Size></WidgetGroup>
      <Template src="skin:xdj_fx_beat.xml"/>
      <WidgetGroup>
        <ObjectName>XdjFxLevelBox</ObjectName><Layout>horizontal</Layout><Size>52f,22f</Size>
        <Children>
          <Number>
            <ObjectName>XdjFxLevelVal</ObjectName><Size>38f,22f</Size><NumberOfDigits>0</NumberOfDigits>
            <Connection><ConfigKey>[Skin],xdj_fx<Variable name="deck"/>_level<Variable name="index"/></ConfigKey></Connection>
          </Number>
          <Label><ObjectName>XdjFxPct</ObjectName><Text>%</Text><Size>14f,22f</Size></Label>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
