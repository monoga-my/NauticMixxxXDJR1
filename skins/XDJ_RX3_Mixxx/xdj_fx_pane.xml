<!-- XDJ-R1 Beat FX pane for one deck (effect unit deck + 2): left-aligned FX
     buttons with per-FX BEAT and LEVEL/DEPTH (0-200%) columns. -->
<Template>
  <WidgetGroup>
    <ObjectName>XdjFxPane</ObjectName><Layout>vertical</Layout><Size>0me,0me</Size>
    <Children>
      <WidgetGroup>
        <ObjectName>XdjFxPaneTitleRow</ObjectName><Layout>horizontal</Layout><Size>0me,24f</Size>
        <Children>
          <Label><ObjectName>XdjFxPaneTitle</ObjectName><Text>DECK <Variable name="deck"/> FX</Text></Label>
          <Label>
            <ObjectName>XdjFxMidHi</ObjectName><Text>MID+HI</Text><Size>58f,18f</Size>
            <Connection><ConfigKey>[EffectRack1_EffectUnit<Variable name="unit"/>],rx3_keep_lows</ConfigKey><BindProperty>visible</BindProperty></Connection>
          </Label>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>XdjFxColHeader</ObjectName><Layout>horizontal</Layout><Size>0me,16f</Size>
        <Children>
          <Label><ObjectName>XdjFxColTitleLeft</ObjectName><Text>FX</Text><Size>82f,16f</Size></Label>
          <WidgetGroup><Size>0me,1f</Size></WidgetGroup>
          <Label><ObjectName>XdjFxColTitle</ObjectName><Text>BEAT</Text><Size>42f,16f</Size></Label>
          <Label><ObjectName>XdjFxColTitle</ObjectName><Text>DEPTH</Text><Size>52f,16f</Size></Label>
        </Children>
      </WidgetGroup>
      <Template src="skin:xdj_fx_row.xml"><SetVariable name="index">1</SetVariable><SetVariable name="slot">1</SetVariable><SetVariable name="name">TRANS</SetVariable></Template>
      <WidgetGroup>
        <ObjectName>XdjFxRow</ObjectName><Layout>horizontal</Layout><Size>0me,26f</Size>
        <Connection><ConfigKey>[Skin],xdj_fx<Variable name="deck"/>_edit</ConfigKey><Transform><IsEqual>2</IsEqual></Transform><BindProperty>highlight</BindProperty></Connection>
        <Children>
          <Label>
            <ObjectName>XdjFxName</ObjectName><Text>SIDECHAIN</Text><Size>82f,22f</Size>
            <Connection><ConfigKey>[EffectRack1_EffectUnit<Variable name="unit"/>],rx3_sidechain_enabled</ConfigKey><BindProperty>highlight</BindProperty></Connection>
          </Label>
          <WidgetGroup><Size>0me,1f</Size></WidgetGroup>
          <Label><ObjectName>XdjFxBeatCell</ObjectName><Text>BASS</Text><Size>42f,22f</Size></Label>
          <WidgetGroup>
            <ObjectName>XdjFxLevelBox</ObjectName><Layout>horizontal</Layout><Size>52f,22f</Size>
            <Children>
              <Number>
                <ObjectName>XdjFxLevelVal</ObjectName><Size>38f,22f</Size><NumberOfDigits>0</NumberOfDigits>
                <Connection><ConfigKey>[Skin],xdj_fx<Variable name="deck"/>_level2</ConfigKey></Connection>
              </Number>
              <Label><ObjectName>XdjFxPct</ObjectName><Text>%</Text><Size>14f,22f</Size></Label>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>
      <Template src="skin:xdj_fx_row.xml"><SetVariable name="index">3</SetVariable><SetVariable name="slot">3</SetVariable><SetVariable name="name">ECHO</SetVariable></Template>
      <WidgetGroup>
        <ObjectName>XdjFxRow</ObjectName><Layout>horizontal</Layout><Size>0me,26f</Size>
        <Connection><ConfigKey>[Skin],xdj_fx<Variable name="deck"/>_edit</ConfigKey><Transform><IsEqual>4</IsEqual></Transform><BindProperty>highlight</BindProperty></Connection>
        <Children>
          <Label>
            <ObjectName>XdjFxName</ObjectName><Text>ROLL</Text><Size>82f,22f</Size>
            <Connection><ConfigKey>[Skin],xdj_fx<Variable name="deck"/>_roll</ConfigKey><BindProperty>highlight</BindProperty></Connection>
          </Label>
          <WidgetGroup><Size>0me,1f</Size></WidgetGroup>
          <Template src="skin:xdj_fx_beat.xml"><SetVariable name="index">4</SetVariable></Template>
          <Label><ObjectName>XdjFxLevelDash</ObjectName><Text>—</Text><Size>52f,22f</Size></Label>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
