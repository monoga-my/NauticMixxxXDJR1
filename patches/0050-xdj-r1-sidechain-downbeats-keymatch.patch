+// Audio-thread-only bass buffers for sidechain ducking (deck 0 = [Channel1],
+// deck 1 = [Channel2]). Published in EngineMixer::processChannels and read
+// moments later in EngineEffectChain::process on the same audio thread.
+CSAMPLE g_rx3BassLowState[2][4] = {{0, 0, 0, 0}, {0, 0, 0, 0}};
+CSAMPLE g_rx3BassMono[2][kMaxEngineSamples / 2] = {};
+std::size_t g_rx3BassFrames[2] = {0, 0};
+
+void rx3ApplySidechain(int sourceDeck,
+        CSAMPLE& envState,
+        const CSAMPLE* pIn,
+        CSAMPLE* pOut,
+        std::size_t numSamples,
+        double sampleRate,
+        CSAMPLE depth) {
+    const double sr = std::max(1.0, sampleRate);
+    const CSAMPLE attack = static_cast<CSAMPLE>(std::exp(-1.0 / (0.003 * sr)));
+    const CSAMPLE release = static_cast<CSAMPLE>(std::exp(-1.0 / (0.120 * sr)));
+    const std::size_t numFrames = numSamples / 2;
+    const std::size_t srcFrames = (sourceDeck >= 0 && sourceDeck < 2) ? g_rx3BassFrames[sourceDeck] : 0;
+    const CSAMPLE* pBass = (sourceDeck >= 0 && sourceDeck < 2) ? g_rx3BassMono[sourceDeck] : nullptr;
+    CSAMPLE env = envState;
+    for (std::size_t f = 0; f < numFrames; ++f) {
+        const CSAMPLE bass = (pBass && f < srcFrames) ? pBass[f] : 0.0f;
+        const CSAMPLE coeff = bass > env ? attack : release;
+        env = coeff * env + (1.0f - coeff) * bass;
+        const CSAMPLE duck = std::clamp(env * 3.5f, 0.0f, 1.0f);
+        const CSAMPLE gain = 1.0f - depth * duck;
+        pOut[2 * f] = pIn[2 * f] * gain;
+        pOut[2 * f + 1] = pIn[2 * f + 1] * gain;
+    }
+    envState = env;
+}
 } // namespace
 
+void EngineEffectChain::rx3PublishDeckBass(int deckIndex,
+        const CSAMPLE* pBuffer,
+        std::size_t numSamples,
+        double sampleRate) {
+    if (deckIndex < 0 || deckIndex >= 2 || !pBuffer) {
+        return;
+    }
+    constexpr double kBassCornerHz = 150.0;
+    constexpr double kTwoPi = 6.283185307179586;
+    const CSAMPLE a = static_cast<CSAMPLE>(
+            std::exp(-kTwoPi * kBassCornerHz / std::max(1.0, sampleRate)));
+    const CSAMPLE b = 1.0f - a;
+    const std::size_t numFrames = std::min<std::size_t>(numSamples / 2, kMaxEngineSamples / 2);
+    CSAMPLE* state = g_rx3BassLowState[deckIndex];
+    for (std::size_t f = 0; f < numFrames; ++f) {
+        const CSAMPLE xL = pBuffer[2 * f];
+        const CSAMPLE xR = pBuffer[2 * f + 1];
+        state[0] = b * xL + a * state[0];
+        state[1] = b * state[0] + a * state[1];
+        state[2] = b * xR + a * state[2];
+        state[3] = b * state[2] + a * state[3];
+        g_rx3BassMono[deckIndex][f] = 0.5f * (std::abs(state[1]) + std::abs(state[3]));
+    }
+    g_rx3BassFrames[deckIndex] = numFrames;
+}
+
+void EngineEffectChain::rx3ClearDeckBass(int deckIndex) {
+    if (deckIndex < 0 || deckIndex >= 2) {
+        return;
+    }
+    g_rx3BassFrames[deckIndex] = 0;
+    for (int i = 0; i < 4; ++i) {
+        g_rx3BassLowState[deckIndex][i] = 0.0f;
+    }
+}
