@@ -46,4 +46,26 @@ inline QList<quint32> matchingTrackIds(
     });
     return result;
 }
+// XDJ-R1 MATCH filter: the tracks of the list on screen, in their order, whose
+// key is compatible with the master deck's current key (same, relative, or one
+// step around the circle of fifths) and whose tempo is within `tolerance` of
+// the master deck's current tempo. The master deck's own track is left out.
+inline QList<quint32> matchListTrackIds(
+        const QHash<quint32,mixxx::rekordbox::RuntimeTrack>& tracks,
+        const QList<quint32>& listIds, const QString& referencePath,
+        mixxx::track::io::key::ChromaticKey key, double bpm, double tolerance=0.16) {
+    QList<quint32> result;
+    if(key==mixxx::track::io::key::INVALID || !std::isfinite(bpm) || bpm<=0) return result;
+    const auto compatible=KeyUtils::getCompatibleKeys(key);
+    for(const auto id:listIds) {
+        const auto track=tracks.constFind(id);
+        if(track==tracks.cend() || result.contains(id)) continue;
+        if(!referencePath.isEmpty() && track->resolvedAudioPath==referencePath) continue;
+        if(!track->bpm || !std::isfinite(*track->bpm) || *track->bpm<=0) continue;
+        if(std::abs(*track->bpm-bpm)>bpm*tolerance) continue;
+        if(!compatible.contains(KeyUtils::guessKeyFromText(track->key))) continue;
+        result.append(id);
+    }
+    return result;
+}
 } // namespace rx3
