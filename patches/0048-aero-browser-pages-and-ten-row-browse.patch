diff --git a/src/widget/rx3aero.h b/src/widget/rx3aero.h
new file mode 100644
index 0000000..b18f832
--- /dev/null
+++ b/src/widget/rx3aero.h
@@ -0,0 +1,43 @@
+#pragma once
+
+#include <QColor>
+#include <QLinearGradient>
+#include <QPainter>
+#include <QRect>
+#include <QString>
+#include <initializer_list>
+#include <utility>
+
+// Dark Frutiger Aero palette for the RX3 pages that paint themselves or carry
+// their own style sheets (BROWSE, INFO, tools, UTILITY, SHORTCUT). The skin's
+// style.qss uses the same colours for everything else.
+namespace rx3::aero {
+
+// Style sheet fragments (no trailing semicolon).
+// Selected row or item: an icy-blue gel that keeps white text readable.
+inline const QString kSelect = QStringLiteral(
+        "qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #7fd8ff,stop:0.48 #2a9be6,"
+        "stop:0.52 #1572c0,stop:1 #2b9fe8)");
+// Selection while focus is elsewhere (for example on the category rail).
+inline const QString kSelectDim = QStringLiteral(
+        "qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #5a6680,stop:0.5 #2a3246,stop:1 #353f57)");
+
+inline QColor rowColor(int row) {
+    return row % 2 ? QColor("#111725") : QColor("#000000");
+}
+inline void fillGradient(QPainter* painter, const QRect& rect,
+        std::initializer_list<std::pair<qreal, QColor>> stops) {
+    QLinearGradient gradient(rect.topLeft(), rect.bottomLeft());
+    for (const auto& stop : stops) gradient.setColorAt(stop.first, stop.second);
+    painter->fillRect(rect, gradient);
+}
+inline void fillSelection(QPainter* painter, const QRect& rect) {
+    fillGradient(painter, rect, {{0, QColor("#7fd8ff")}, {0.48, QColor("#2a9be6")},
+            {0.52, QColor("#1572c0")}, {1, QColor("#2b9fe8")}});
+}
+inline void fillHeader(QPainter* painter, const QRect& rect) {
+    fillGradient(painter, rect, {{0, QColor("#56627e")}, {0.46, QColor("#2a3348")},
+            {0.5, QColor("#171d2c")}, {1, QColor("#1f2739")}});
+}
+
+} // namespace rx3::aero
