+// Ten track rows per page (the RX3 shows twelve): larger rows and larger text
+// for small screens. The column header takes the remainder, about one row.
+inline constexpr int kBrowserVisibleRows=10;
+inline BrowserRows visibleBrowserRows(int availableHeight) {
+    const int available=qMax(kBrowserVisibleRows+1,availableHeight);
+    const int row=available/(kBrowserVisibleRows+1);
+    return {row,available-kBrowserVisibleRows*row};
