+}
+// BROWSE key highlight against the master deck: the same key (green) or a
+// related key on the Camelot wheel (yellow: relative major/minor, one step
+// either way).
+enum class KeyMatch { None, Same, Related };
+inline KeyMatch keyMatch(mixxx::track::io::key::ChromaticKey reference,
+        mixxx::track::io::key::ChromaticKey key) {
+    using mixxx::track::io::key::INVALID;
+    if(reference==INVALID || key==INVALID) return KeyMatch::None;
+    if(key==reference) return KeyMatch::Same;
+    return KeyUtils::getCompatibleKeys(reference).contains(key) ? KeyMatch::Related : KeyMatch::None;
+}
