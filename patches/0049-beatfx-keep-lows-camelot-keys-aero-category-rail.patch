+// Aero category label: one line, so icons and text match from row to row.
+// Only two-word names (DATE ADDED) wrap onto a second line.
+inline QString browserCategoryLines(const QString& label) {
+    if (label.contains(' ')) return label.section(' ', 0, 0) + "\n" + label.section(' ', 1);
+    return label;
+}
+// Each category gets its own pastel tint so the rail reads at a glance.
+inline QColor browserCategoryTint(const QString& label) {
+    if (label == "ARTIST" || label == "PLAYLIST" || label == "RATING" || label == "LABEL")
+        return QColor("#ff8ac8");
+    if (label == "TRACK" || label == "TRACKS" || label == "HISTORY" || label == "GENRE")
+        return QColor("#c3a8ff");
+    return QColor("#6fd6ff");
+}
+// Glossy glass orb behind the line icon: tinted body lit from below, a soft
+// rim and a curved white specular cap.
+inline void drawAeroCategoryIcon(QPainter* p, const QRectF& rect, const QString& label, bool selected) {
+    const QColor tint = browserCategoryTint(label);
+    p->save(); p->setRenderHint(QPainter::Antialiasing);
+    QLinearGradient body(rect.topLeft(), rect.bottomLeft());
+    body.setColorAt(0, tint.darker(selected ? 170 : 300));
+    body.setColorAt(0.55, tint.darker(selected ? 120 : 190));
+    body.setColorAt(1, selected ? tint.lighter(120) : tint);
+    p->setBrush(body);
+    p->setPen(QPen(selected ? QColor(255, 255, 255, 230) : tint.lighter(130), rect.width() / 32));
+    p->drawEllipse(rect);
+    const QRectF cap(rect.left() + rect.width() * 0.17, rect.top() + rect.height() * 0.05,
+            rect.width() * 0.66, rect.height() * 0.44);
+    QLinearGradient shine(cap.topLeft(), cap.bottomLeft());
+    shine.setColorAt(0, QColor(255, 255, 255, 170)); shine.setColorAt(1, QColor(255, 255, 255, 0));
+    p->setPen(Qt::NoPen); p->setBrush(shine); p->drawEllipse(cap);
+    p->restore();
+    const qreal inset = rect.width() * 0.22;
+    drawBrowserCategoryIcon(p, rect.adjusted(inset, inset, -inset, -inset), label, Qt::white);
+}
 } // namespace rx3
