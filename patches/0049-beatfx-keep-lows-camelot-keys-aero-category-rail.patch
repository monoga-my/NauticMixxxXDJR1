+namespace {
+// Complementary split: lows = 12 dB/octave low-pass of the input, highs =
+// input - lows, so lows + highs always equal the input exactly.
+void rx3SplitLows(CSAMPLE* state, const CSAMPLE* pIn, CSAMPLE* pLows,
+        CSAMPLE* pHighs, unsigned int numSamples, double sampleRate) {
+    constexpr double kCornerHz = 250.0;
+    constexpr double kTwoPi = 6.283185307179586;
+    const CSAMPLE a = static_cast<CSAMPLE>(
+            std::exp(-kTwoPi * kCornerHz / std::max(1.0, sampleRate)));
+    const CSAMPLE b = 1.0f - a;
+    for (unsigned int i = 0; i + 1 < numSamples; i += 2) {
+        for (unsigned int side = 0; side < 2; ++side) {
+            CSAMPLE* stage = state + 2 * side;
+            const CSAMPLE x = pIn[i + side];
+            stage[0] = b * x + a * stage[0];
+            stage[1] = b * stage[0] + a * stage[1];
+            pLows[i + side] = stage[1];
+            pHighs[i + side] = x - stage[1];
+        }
+    }
+}
