+namespace rx3 {
+// Recessed glass tube: dark inset with a top shadow and a light lower lip,
+// filled by a pink-to-white glow that ends in a bright light orb.
+inline void drawAeroTube(QPainter* painter,QRectF bar,double fraction,double scale) {
+    if (bar.width()<=0) return;
+    painter->save();painter->setRenderHint(QPainter::Antialiasing);
+    bar=bar.adjusted(0,-1.5*scale,0,1.5*scale);
+    const qreal radius=bar.height()/2;
+    QLinearGradient inset(0,bar.top(),0,bar.bottom());
+    inset.setColorAt(0,QColor(0,0,0,255));inset.setColorAt(0.6,QColor(14,16,28));inset.setColorAt(1,QColor(40,46,70));
+    painter->setPen(QPen(QColor(150,215,255,110),1));painter->setBrush(inset);
+    painter->drawRoundedRect(bar,radius,radius);
+    const qreal filled=bar.width()*qBound(0.0,fraction,1.0);
+    if (filled>0.5) {
+        const QRectF fill(bar.left(),bar.top(),qMax(bar.height(),filled),bar.height());
+        QLinearGradient glow(fill.left(),0,fill.right(),0);
+        glow.setColorAt(0,QColor(255,95,180,200));glow.setColorAt(0.85,QColor(255,170,215));glow.setColorAt(1,QColor(255,255,255));
+        painter->setPen(Qt::NoPen);painter->setBrush(glow);
+        painter->drawRoundedRect(fill.adjusted(0.5,0.5,-0.5,-0.5),radius,radius);
+        const QPointF tip(fill.right()-radius,fill.center().y());
+        QRadialGradient orb(tip,radius*2.6);
+        orb.setColorAt(0,QColor(255,255,255,240));orb.setColorAt(0.35,QColor(255,190,228,170));orb.setColorAt(1,QColor(255,95,180,0));
+        painter->setBrush(orb);painter->drawEllipse(tip,radius*2.6,radius*2.6);
+    }
+    QLinearGradient sheen(0,bar.top(),0,bar.center().y());
+    sheen.setColorAt(0,QColor(255,255,255,90));sheen.setColorAt(1,QColor(255,255,255,0));
+    painter->setPen(Qt::NoPen);painter->setBrush(sheen);
+    painter->drawRoundedRect(QRectF(bar.left()+radius,bar.top()+0.5,qMax(0.0,bar.width()-2*radius),bar.height()/2),radius/2,radius/2);
+    painter->restore();
+}
